  m_text: "<color=#3498DB><b>Violetheart Pendant</b></color>\r\n<color=#888888>Rare</color>\r\n\r\n<color=#FFD700>Slot:
    Accessory</color>\r\n<color=#FF8800>\u26A1 Stat Roll: 1%</color>\r\n<color=#00FF00>HP:
    +0</color> <color=#888888>(max 35)</color>\r\n<color=#FF00FF>Crit Rate: +0.1%</color>
    <color=#888888>(max 7.0%)</color>\r\n<color=#FF00FF>Crit Dmg: +0.2%</color> <color=#888888>(max
    17.5%)</color>\r\n\r\n<color=#FFD700>Passive:</color>\r\n<color=#FFFF00>When
    hit, gain 15% movement speed for 2s.</color>"
